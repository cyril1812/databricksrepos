{
  "custom_summary": "Budget Alert: 75% Threshold Reached",
  "evaluation": {
    "source": {
      "name": "utilization_pct"
    },
    "comparison_operator": "GREATER_THAN_OR_EQUAL",
    "threshold": {
      "value": {
        "double_value": 75.0
      }
    },
    "empty_result_state": "OK",
    "notification": {
      "retrigger_seconds": 0,
      "notify_on_ok": true
    }
  },
  "schedule": {
    "quartz_cron_schedule": "0 0 11 ? * Mon",
    "timezone_id": "UTC"
  },
  "query_lines": [
    "",
    "WITH monthly_spend AS (",
    "  SELECT",
    "    COALESCE(ROUND(SUM(",
    "      CAST(u.usage_quantity AS DOUBLE) *",
    "      COALESCE(CAST(p.pricing.effective_list.default AS DOUBLE), 0)",
    "    ), 2), 0) AS current_month_spend",
    "  FROM system.billing.usage u",
    "  LEFT JOIN system.billing.list_prices p",
    "    ON u.sku_name = p.sku_name",
    "    AND (p.price_end_time IS NULL OR u.usage_date < p.price_end_time)",
    "  INNER JOIN salama_insurance.salama_silver.workspace_mapping wm",
    "    ON u.workspace_id = wm.workspace_id",
    "  WHERE u.usage_date >= DATE_TRUNC('MONTH', CURRENT_DATE())",
    "    AND u.usage_date <= CURRENT_DATE()",
    "    AND wm.subscription_name = 'STAR Group Sandbox'",
    ")",
    "SELECT",
    "  current_month_spend,",
    "  500 AS budget_limit,",
    "  ROUND(current_month_spend / 500 * 100, 1) AS utilization_pct,",
    "  ROUND(500 - current_month_spend, 2) AS remaining_budget,",
    "  ROUND(current_month_spend / GREATEST(DAY(CURRENT_DATE()), 1), 2) AS daily_burn_rate,",
    "  ROUND(",
    "    (current_month_spend / GREATEST(DAY(CURRENT_DATE()), 1)) *",
    "    DAY(LAST_DAY(CURRENT_DATE())), 2",
    "  ) AS projected_month_end,",
    "  CASE",
    "    WHEN current_month_spend / 500 >= 1.0 THEN 'CRITICAL - Budget Exceeded!'",
    "    WHEN current_month_spend / 500 >= 0.9 THEN 'WARNING - 90%+ Budget Used'",
    "    WHEN current_month_spend / 500 >= 0.75 THEN 'CAUTION - 75%+ Budget Used'",
    "    ELSE 'OK - Within Budget'",
    "  END AS alert_status",
    "FROM monthly_spend"
  ],
  "custom_description_lines": [
    "<h2>Budget Warning - 75% Utilized</h2><p>Your Databricks monthly spend has exceeded <b>75%</b> of the configured budget ($500).</p><p><b>Current Status:</b> {{ALERT_STATUS}}</p>{{QUERY_RESULT_TABLE}}<p>Review your spend in the FinOps Monitor Dashboard.</p>"
  ]
}
